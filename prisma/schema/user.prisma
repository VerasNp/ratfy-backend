model User {
    id            String         @id
    name          String
    email         String         @unique
    password      String
    birthDate     DateTime
    verifiedAt    DateTime?
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    artist        Artist?
    playlists     Playlist[]
    refreshTokens RefreshToken[]
    role          Role[]
}
