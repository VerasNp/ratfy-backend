<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
  </head>
  <body style="font-family: sans-serif; background: #f4f4f4; padding: 20px; margin: 0;">
    <div style="max-width: 480px; margin: 0 auto; background: #fff; padding: 24px; border-radius: 8px;">
      <h1 style="color: #111;">Hi, {{name}}!</h1>
      <p style="color: #333;">You requested a password reset. Click the button below to set a new password.</p>
      <a href="{{resetUrl}}" style="display: inline-block; padding: 12px 24px; background: #4f46e5; color: #fff; text-decoration: none; border-radius: 4px;">
        Reset Password
      </a>
      <p style="color: #666; font-size: 12px;">If you didn't request this, you can ignore this email. The link expires in 1 hour.</p>
    </div>
  </body>
</html>
