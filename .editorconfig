root = true

# -------------------------
# Default (TypeScript / JS)
# -------------------------
[*]
indent_style = tab
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# -------------------------
# YAML / Docker / configs
# -------------------------
[*.yml]
indent_style = space
indent_size = 2

[*.yaml]
indent_style = space
indent_size = 2

[docker-compose*.yml]
indent_style = space
indent_size = 2

# -------------------------
# JSON (always spaces)
# -------------------------
[*.json]
indent_style = space
indent_size = 2
